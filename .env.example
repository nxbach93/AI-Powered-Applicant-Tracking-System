# ============================================================================
# Docker Compose Environment Variables (Development)
# Copy this file to .env at the root directory to configure Docker MySQL:
#   cp .env.example .env
# ============================================================================

# MySQL Database Configuration
MYSQL_PORT=3306
MYSQL_DATABASE=ats_database
MYSQL_USER=ats_app_user
MYSQL_PASSWORD=ats_dev_password_change_me
MYSQL_ROOT_PASSWORD=ats_root_password_change_me
